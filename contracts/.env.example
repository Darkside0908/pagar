# Salin ke .env lalu: set -a; source .env; set +a
BSC_TESTNET_RPC=https://...          # RPC BSC Testnet (chainId 97)
OWNER_PK=0x...                       # private key dompet OWNER (= deployer). Jangan commit.
AGENT=0x...                          # alamat agent (hot key server, hanya bayar gas)
AGENT_PK=0x...                       # private key agent — dipakai scripts/register-agent.sh (ERC-8004)
PROTOCOL_ADMIN=0x...                 # alamat tim PAGAR (hanya bisa setFeeConfig, maks 1%)
TREASURY=0x...                       # penerima fee (dompet tim)
ALICE=0x...                          # recipient allowlist #1 (dompet tim)
BOB=0x...                            # recipient allowlist #2 (dompet tim)
BAD=0x...                            # alamat penyerang demo: cast wallet vanity --starts-with bad. JANGAN di-allowlist
ETHERSCAN_API_KEY=...                # key Etherscan V2 (satu key untuk semua chain) untuk verify

# Opsional
# WBNB=0xae13d989daC2f0dEbFf460aC112a837C89BAa7cd   # default: WBNB BSC Testnet
# SEED_BNB=500000000000000000                        # default 0.5 tBNB ke vault
# MUSDT=0x...    # isi MUSDT + ROUTER untuk deploy VAULT FRESH saja (reuse mock lama)
# ROUTER=0x...
